{
  "name": "Creative tournament",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Creative tournament brief",
        "formDescription": "Eight AI-written ad concepts will compete in a bracket judged by blind critic agents. You pick the winner of the final in Slack.",
        "formFields": {
          "values": [
            { "fieldLabel": "Brief", "fieldType": "textarea", "requiredField": true },
            { "fieldLabel": "Audience", "requiredField": true },
            { "fieldLabel": "Channels", "placeholder": "TikTok, Meta", "requiredField": true },
            { "fieldLabel": "Brand voice", "fieldType": "textarea" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Brief form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 300],
      "webhookId": "creative-tournament-form"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:3000/tournaments",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brief: { brief: $json['Brief'], audience: $json['Audience'], channels: String($json['Channels']).split(',').map(s => s.trim()).filter(Boolean), brandVoice: $json['Brand voice'] || undefined }, resumeUrl: $execution.resumeUrl }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Start tournament",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 45,
        "resumeUnit": "minutes",
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Wait for finalists",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [480, 300],
      "webhookId": "creative-tournament-finalists"
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "id", "value": "={{ $env.SLACK_CHANNEL_ID }}" },
        "message": "=*Creative tournament {{ $json.body.tournamentId }}: pick the winner*\n\n*A* · _{{ $json.body.finalists[0].angle }}_\n*{{ $json.body.finalists[0].headline }}*\n{{ $json.body.finalists[0].hook }}\n\n*B* · _{{ $json.body.finalists[1].angle }}_\n*{{ $json.body.finalists[1].headline }}*\n{{ $json.body.finalists[1].hook }}\n\nThe panel favours *{{ $json.body.panelPick === $json.body.finalists[0].id ? 'A' : 'B' }}*. No answer in {{ $json.body.timeoutMinutes }} minutes and the panel's pick is crowned.\nFull bracket: {{ $json.body.bracketUrl }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Crown A",
            "disapproveLabel": "Crown B"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": "={{ $json.body.timeoutMinutes }}",
              "resumeUnit": "minutes"
            }
          }
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Slack: pick A or B",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [720, 300],
      "webhookId": "creative-tournament-slack-approval",
      "credentials": { "slackApi": { "id": "SLACK_CREDENTIAL_ID", "name": "Slack bot" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "answered",
              "leftValue": "={{ $json.data && typeof $json.data.approved === 'boolean' }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Answered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "jsCode": "const req = $('Wait for finalists').first().json.body;\nconst approved = $input.first().json.data.approved;\nreturn [{ json: { tournamentId: req.tournamentId, crownUrl: req.crownUrl, token: req.token, winnerId: approved ? req.finalists[0].id : req.finalists[1].id, by: 'human' } }];"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Human pick",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "jsCode": "const req = $('Wait for finalists').first().json.body;\nreturn [{ json: { tournamentId: req.tournamentId, crownUrl: req.crownUrl, token: req.token, winnerId: req.panelPick, by: 'auto' } }];"
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Panel pick (timeout)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:3000/tournaments/{{ $json.tournamentId }}/crown",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ winnerId: $json.winnerId, by: $json.by, token: $json.token }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Crown",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "mode": "id", "value": "={{ $env.SLACK_CHANNEL_ID }}" },
        "text": "=:white_check_mark: Tournament {{ $('Wait for finalists').first().json.body.tournamentId }} crowned ({{ $json.crown.by === 'human' ? 'your pick' : 'panel pick after timeout' }}). Creative brief and Asana task are ready. Bracket: {{ $('Wait for finalists').first().json.body.bracketUrl }}",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "Slack: crowned",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1680, 300],
      "credentials": { "slackApi": { "id": "SLACK_CREDENTIAL_ID", "name": "Slack bot" } }
    }
  ],
  "connections": {
    "Brief form": { "main": [[{ "node": "Start tournament", "type": "main", "index": 0 }]] },
    "Start tournament": { "main": [[{ "node": "Wait for finalists", "type": "main", "index": 0 }]] },
    "Wait for finalists": { "main": [[{ "node": "Slack: pick A or B", "type": "main", "index": 0 }]] },
    "Slack: pick A or B": { "main": [[{ "node": "Answered?", "type": "main", "index": 0 }]] },
    "Answered?": {
      "main": [
        [{ "node": "Human pick", "type": "main", "index": 0 }],
        [{ "node": "Panel pick (timeout)", "type": "main", "index": 0 }]
      ]
    },
    "Human pick": { "main": [[{ "node": "Crown", "type": "main", "index": 0 }]] },
    "Panel pick (timeout)": { "main": [[{ "node": "Crown", "type": "main", "index": 0 }]] },
    "Crown": { "main": [[{ "node": "Slack: crowned", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
}
