# Required
ANTHROPIC_API_KEY=

# Models
GENERATOR_MODEL=claude-sonnet-5-5
TIEBREAK_MODEL=claude-sonnet-5-5
CRITIC_MODEL=claude-haiku-5-5

# Behaviour
MOCK_MODE=true
MAX_BUDGET_USD=1.00
HUMAN_TIMEOUT_MINUTES=30
SCORE_WEIGHTS=performance:0.4,brand:0.35,compliance:0.25
SEED_STRATEGY=random
BRAND_GUIDE_PATH=fixtures/brand/budgetly.md
DB_PATH=runs/tournaments.db
RUNS_DIR=runs
PORT=3000
# Public base URL used for bracket links sent to Slack/n8n
PUBLIC_BASE_URL=http://localhost:3000

# Signs crown tokens (HMAC-SHA256). Required when MOCK_MODE=false.
CROWN_SECRET=

# Real integrations (only read when MOCK_MODE=false)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
ASANA_PAT=
ASANA_PROJECT_GID=
# Either the JSON itself or a path to the key file
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
